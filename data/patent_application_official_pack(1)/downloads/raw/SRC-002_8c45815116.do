        var cDate  = new Date();
        var cDay   = cDate.getDate();
        var cYear  = cDate.getFullYear();
        var cMonth = cDate.getMonth() + 1;

        if(parseInt(cMonth) < 10) {
            cMonth = "0" + cMonth;
        }

        if(parseInt(cDay) < 10) {
            cDay = "0" + cDay;
        }

        var curDate = cYear + "" + cMonth + "" + cDay;
        if(curDate <= endDate) {
            return true;
        } else {
            return false;
