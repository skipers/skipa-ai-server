$(document).ready(function(){
	fnRaonKInstallCheck();
	
	  $('.eyes').on('click',function(){
		  
		  var id =$(this).attr('id');
		  var input_id ='#' +  id.substr( id.indexOf('_')+1);
		  var eyeVisible = '#eyeVisible_'+  id.substr( id.indexOf('_')+1);
		  var eyeHide = '#eyeHide_'+  id.substr( id.indexOf('_')+1);
		  
		  if(id.indexOf('eyeVisible') != -1){
			  $(input_id).attr('type',"text");
			  $(this).css('display', 'none');
			  $(eyeHide).css('display', '');
		  }else{
			  $(input_id).attr('type',"password");
			  $(this).css('display', 'none');
			  $(eyeVisible).css('display', '');
		  }
		  return false;
		  });
	  
});

function checkCallback(code, obj){
	var checkInstall = obj.is_cs_install;
	if(checkInstall){
        $("#magicLine_checkMessage1").css('color','blue');
        $("#magicLine_checkMessage1").text('설치완료');
    }else{
        $("#magicLine_checkMessage1").css('color','red');
        $("#magicLine_checkMessage1").text('미설치');
    }

}

