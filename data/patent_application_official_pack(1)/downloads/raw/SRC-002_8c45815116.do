/*
 * 발급여부 확인 주민,사업자 등록번호 체크
 * @param {obejct} objForm: 폼  {string} gubunId : 구분자
 * @return true: 정상, false 이상
 */
function fnCheckValidation(objCdChkForm, objInpForm, guBunId, apTpVal){
    var blnRet = true;

    if(guBunId == "jumin"){
        if( objCdChkForm['resid'].value.split("-").join("").length < 13 && (apTp == "A0904" || apTp == "A0906" ) ) {
                      alert("주민(법인)등록번호를 입력하셔야 합니다.");
                      objInpForm['ResId1'][0].focus();
                      blnRet= false;
                }else if( objCdChkForm['resid'].value.split("-").join("").length < 13 && apTp == "A0901"  ) {
                      alert("주민(법인)등록번호를 입력하셔야 합니다.");
                      objInpForm['ResId1'][1].focus();
                      blnRet= false;
                }else if( objCdChkForm['resid'].value.split("-").join("").length < 13 && apTp == "A0905"  ) {
                      alert("주민(법인)등록번호를 입력하셔야 합니다.");
                      objInpForm['ResId1'][2].focus();
                      blnRet= false;
                }else if( objCdChkForm['resid'].value.split("-").join("").length < 13 && apTp == "A0906"  ) { // 외국자연인
                      alert("외국인 등록번호를 입력하셔야 합니다.");
                      objInpForm['ResId1'][3].focus();
                      blnRet= false;
        }
    }else if(guBunId == "brngo"){

        if( objCdChkForm['resid'].value.split("-").join("").length < 10 && apTpVal == "A0901"  ) {
                      alert("사업자 등록번호를 입력하셔야 합니다.");
                      objInpForm['brgno1'][0].focus();
                      blnRet= false;
                }else if( objCdChkForm['resid'].value.split("-").join("").length < 10 && apTpVal == "A0902"  ) {
                      alert("사업자 등록번호를 입력하셔야 합니다.");
                      objInpForm['brgno1'][1].focus();
                      blnRet= false;
                }else if( objCdChkForm['resid'].value.split("-").join("").length < 10 && apTpVal == "A0905"  ) {
                      alert("사업자 등록번호를 입력하셔야 합니다.");
                      objInpForm['brgno1'][2].focus();
                      blnRet= false;
                }else if( objCdChkForm['resid'].value.split("-").join("").length < 10 && apTpVal == "A0907"  ) { // 법인이아닌사단재단
                      alert("사업자 등록번호를 입력하셔야 합니다.");
                      objInpForm['brgno1'][1].focus();
                      blnRet= false;
        }
    }

    return blnRet;
}

