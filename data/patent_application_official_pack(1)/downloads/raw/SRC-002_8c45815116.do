/**
 * PC / Mobile 분기
 */
 function fnMobileChk(){

	    if(/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)){
	         $(".PcMenu").hide(); //PC 전용 메뉴
	         $(".MobileMenu").show(); //Mobile&Tab 전용 메뉴
	         $(".mbPatentGroup").show();
	         $(".m_form").hide();
	        $('body').addClass('offPc');
	        if (bizTpcdChk != null && bizTpcdChk != "") {
		        if(bizTpcdChk == "A0607"){
			        $(".m_apply").css('position', 'relative');
			        $(".m_apply").css('left', '1%');
			        $(".m_mock").css('position', 'relative');
			        $(".m_mock").css('left', '1%');
		        }
			}
	    }else{
	         $(".PcMenu").show(); //PC 전용 메뉴
	         $(".MobileMenu").hide(); //Mobile&Tab 전용 메뉴
	         $(".mbPatentGroup").hide();
	         $(".m_form").show();
	    }
	}
