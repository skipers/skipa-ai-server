	var hidden = values.hidden;
	var hmac = values.hmac;
	var frmId = use_form_id?"_"+document.getElementById("hidfrmId").value:"";
	var request = new XMLHttpRequest();

	request.open("POST", "/smart/demo/ajaxTest.jsp", false);
