function Install_Handler( flag ) {

    if(flag){
        $("#sga_PrintManager").css('color','blue');
        $("#sga_PrintManager").text('설치완료');
    }else{
        $("#sga_PrintManager").css('color','red');
        $("#sga_PrintManager").text('미설치');
    }
}

