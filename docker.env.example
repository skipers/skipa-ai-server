# Copy this file to .env before running docker compose:
#   cp docker.env.example .env

# Ports
CHATBOT_PORT=8001
EVAL_LOGIC_PORT=8000

# Docker build option.
# false: OpenAI embedding path only, much lighter image.
# true: also install HuggingFace local embeddings and BERTScore packages.
INSTALL_LOCAL_EMBEDDINGS=false

# LLM / embedding
INTENT_PROVIDER=ollama
ANSWER_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1
OPENAI_VLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-large

# Local lightweight intent model
GEN_MODEL=qwen2.5:1.5b
INTENT_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.0
INTENT_LLM_TIMEOUT=45
ANSWER_LLM_TIMEOUT=180
CHATBOT_LLM_TIMEOUT=45
INTENT_NUM_PREDICT=220
ANSWER_NUM_PREDICT=2000

# Retrieval and web augmentation
TOP_K=10
TOP_K_CANDIDATES=80
MIN_LOCAL_CONFIDENCE=0.18
ENABLE_WEB_SEARCH=true
ENABLE_WEB_SEARCH_FALLBACK=true
WEB_SEARCH_LIMIT=5
WEB_SEARCH_TIMEOUT=20
WEB_SEARCH_BLOCKLIST_DOMAINS=namu.wiki,blog.naver.com,m.blog.naver.com,tistory.com,wikipedia.org,ko.wikipedia.org

# External evidence providers
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TOPIC=general
KIPRIS_API_KEY=YOUR_KIPRIS_API_KEY
KOSIS_API_KEY=YOUR_KOSIS_API_KEY

# eval_logic
OPENAI_REPORT_MODEL=gpt-4.1
