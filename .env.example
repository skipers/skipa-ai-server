# Shared data roots
DATA_ROOT=./chatbot/data
SHARED_DATA_ROOT=./data
SHARED_PATENT_ROOT=./data/patent
PATENTS_ROOT=./chatbot/data/mapped_patent_reports
PATENT_APPLICATION_ROOT=./chatbot/data/patent_application_official_pack
WIKI_ROOT=./data/wiki
PRE_EVAL_ROOT=./data/pre_application_cases

# MinIO / S3-compatible object storage
# Local port-forward example: kubectl port-forward svc/skipa-minio 19000:9000
# In-cluster example: http://skipa-minio:9000
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_CONSOLE_URL=http://127.0.0.1:19001
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=skipa
MINIO_PATENT_PREFIX=patents
MINIO_SYNC_ON_STARTUP=true
MINIO_REINDEX_AFTER_SYNC=true

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_COLLECTION_PREFIX=skipa
QDRANT_VECTOR_SIZE=3072
QDRANT_DISTANCE=Cosine
PUBLIC_FILE_BASE_URL=http://localhost:8001/files

# Visual extraction
ENABLE_VISUAL_ASSET_EXTRACTION=true
ENABLE_VISUAL_BASE64=true
VISUAL_BASE64_MAX_BYTES=180000
MAX_VISUAL_ASSETS_PER_DOCUMENT=80

# LLM / embedding providers
INTENT_PROVIDER=openai
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1
OPENAI_VLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
ANSWER_PROVIDER=openai

GEN_MODEL=
INTENT_MODEL=gpt-4.1-mini
ANSWER_MODEL=gpt-4.1
ENABLE_OLLAMA_INTENT_FALLBACK=false

# Retrieval tuning
TOP_K=10
TOP_K_CANDIDATES=80
MIN_LOCAL_CONFIDENCE=0.18

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
MAX_DOC_CHARS=12000
MAX_TOTAL_CONTEXT_CHARS=4200
DYNAMIC_MAX_CONTEXT_CHARS=3600

# Dynamic answer generation
ENABLE_STRUCTURED_FAST_PATH=false
ANSWER_GENERATION_MODE=llm
DYNAMIC_ANSWER_ENABLED=true
DYNAMIC_ANSWER_TIMEOUT=180
CHATBOT_LLM_TIMEOUT=90
INTENT_NUM_PREDICT=180
ANSWER_NUM_PREDICT=4096
DYNAMIC_ANSWER_MODES=comparison

# Web search
ENABLE_WEB_SEARCH=true
WEB_SEARCH_LIMIT=5
WEB_SEARCH_TIMEOUT=20
ENABLE_WEB_SEARCH_FALLBACK=true
WEB_SEARCH_BLOCKLIST_DOMAINS=namu.wiki,blog.naver.com,m.blog.naver.com,tistory.com,wikipedia.org,ko.wikipedia.org

# External evidence providers
TAVILY_API_KEY=<tavily-api-key>
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TOPIC=general
KIPRIS_API_KEY=<kipris-api-key>
KOSIS_API_KEY=<kosis-api-key>

# Logs / diagnostics
RETURN_PERFORMANCE=true
RAG_QUERY_LOG_PATH=./logs/rag_query_log.jsonl
WIKI_AUDITOR_ROOT=./logs/wiki_auditor

# OpenAI
OPENAI_API_KEY=<openai-api-key>

# Backend internal callback auth
INTERNAL_API_KEY=<shared-internal-api-key>

# RabbitMQ workers
# Local port-forward example: kubectl port-forward svc/skipa-rabbitmq 5672:5672 15672:15672
# In-cluster example: RABBITMQ_HOST=skipa-rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<rabbitmq-username>
RABBITMQ_PASSWORD=<rabbitmq-password>
RABBITMQ_VIRTUAL_HOST=/
REPORT_GENERATE_QUEUE=skipa.report.generate
PATENT_EXTRACT_QUEUE=skipa.patent-extract

# Backend callback target
# Local mock backend example: http://localhost:18080
# In-cluster backend example: http://skipa-backend:8080
BACKEND_INTERNAL_BASE_URL=http://localhost:18080
BACKEND_CALLBACK_TIMEOUT=20
WORKER_REQUEUE_ON_CALLBACK_FAILURE=true
WORKER_PREFETCH_COUNT=1
PRE_EVALUATION_MAX_ATTEMPTS=3

# eval_logic worker/runtime knobs
EVAL_LOGIC_WORKER_PROFILE=full
EVAL_LOGIC_WORKER_LOCAL_OUTPUT=false
EVAL_LOGIC_STORAGE_BACKEND=minio
EVAL_LOGIC_OBJECT_PREFIX=
EVAL_LOGIC_PARSED_OBJECT_KEY_TEMPLATE=patents/{patent_id}/parsed.json
EVAL_LOGIC_REPORT_OBJECT_KEY_TEMPLATE=patents/{patent_id}/reports/{report_id}/report.json
EVAL_LOGIC_REPORT_LIST_PREFIX=patents/
EVAL_LOGIC_REPORT_STRICT_MINIO=false
