DATA_ROOT=../data
PATENTS_ROOT=../data/mapped_patent_reports
PATENT_APPLICATION_ROOT=../data/patent_application_official_pack(1)
PUBLIC_FILE_BASE_URL=http://localhost:8001/files

EMBEDDING_MODEL=BAAI/bge-m3

OLLAMA_BASE_URL=http://localhost:11434
GEN_MODEL=qwen2.5:1.5b
INTENT_MODEL=qwen2.5:1.5b
ANSWER_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.0

TOP_K=10
TOP_K_CANDIDATES=80
MIN_LOCAL_CONFIDENCE=0.18

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
MAX_DOC_CHARS=12000
MAX_TOTAL_CONTEXT_CHARS=11000

ENABLE_STRUCTURED_FAST_PATH=false
ANSWER_GENERATION_MODE=llm
DYNAMIC_ANSWER_ENABLED=true
DYNAMIC_ANSWER_TIMEOUT=180
CHATBOT_LLM_TIMEOUT=6
INTENT_NUM_PREDICT=180
ANSWER_NUM_PREDICT=420
MAX_TOTAL_CONTEXT_CHARS=4200
DYNAMIC_MAX_CONTEXT_CHARS=3600
DYNAMIC_ANSWER_MODES=comparison

ENABLE_WEB_SEARCH=true
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_LIMIT=5
WEB_SEARCH_TIMEOUT=20
ENABLE_WEB_SEARCH_FALLBACK=true
WEB_SEARCH_BLOCKLIST_DOMAINS=namu.wiki,blog.naver.com,m.blog.naver.com,tistory.com,wikipedia.org,ko.wikipedia.org

# External evidence providers. Keep real keys only in this local .env file.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TOPIC=general
KIPRIS_API_KEY=YOUR_KIPRIS_API_KEY
KOSIS_API_KEY=YOUR_KOSIS_API_KEY

RETURN_PERFORMANCE=true
RAG_QUERY_LOG_PATH=./logs/rag_query_log.jsonl
WIKI_AUDITOR_ROOT=./logs/wiki_auditor

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
