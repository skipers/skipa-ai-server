DATA_ROOT=./chatbot/data
SHARED_DATA_ROOT=./data
SHARED_PATENT_ROOT=./data/patent
PATENTS_ROOT=./chatbot/data/mapped_patent_reports
PATENT_APPLICATION_ROOT=./chatbot/data/patent_application_official_pack
WIKI_ROOT=./data/wiki
PRE_EVAL_ROOT=./data/pre_application_cases

MINIO_ENDPOINT=http://skipa-minio:9000
MINIO_CONSOLE_URL=http://skipa-minio:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
MINIO_BUCKET=skipa
MINIO_PATENT_PREFIX=patents
MINIO_SYNC_ON_STARTUP=true
MINIO_REINDEX_AFTER_SYNC=true

BACKEND_INTERNAL_BASE_URL=http://skipa-backend:8080
INTERNAL_API_KEY=shared-internal-key
BACKEND_CALLBACK_TIMEOUT=15

QDRANT_URL=http://skipa-qdrant:6333
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION_PREFIX=skipa
QDRANT_VECTOR_SIZE=3072
QDRANT_DISTANCE=Cosine
PUBLIC_FILE_BASE_URL=http://localhost:8001/files

ENABLE_VISUAL_ASSET_EXTRACTION=true
ENABLE_VISUAL_BASE64=true
VISUAL_BASE64_MAX_BYTES=180000
MAX_VISUAL_ASSETS_PER_DOCUMENT=80

INTENT_PROVIDER=openai
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1
OPENAI_VLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
ANSWER_PROVIDER=openai

GEN_MODEL=
INTENT_MODEL=gpt-4.1-mini
ANSWER_MODEL=gpt-4.1
ENABLE_OLLAMA_INTENT_FALLBACK=false

TOP_K=10
TOP_K_CANDIDATES=80
MIN_LOCAL_CONFIDENCE=0.18

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
MAX_DOC_CHARS=12000
MAX_TOTAL_CONTEXT_CHARS=11000

ENABLE_STRUCTURED_FAST_PATH=false
ANSWER_GENERATION_MODE=llm
DYNAMIC_ANSWER_ENABLED=true
DYNAMIC_ANSWER_TIMEOUT=180
CHATBOT_LLM_TIMEOUT=90
INTENT_NUM_PREDICT=180
ANSWER_NUM_PREDICT=4096
MAX_TOTAL_CONTEXT_CHARS=4200
DYNAMIC_MAX_CONTEXT_CHARS=3600
DYNAMIC_ANSWER_MODES=comparison

ENABLE_WEB_SEARCH=true
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_LIMIT=5
WEB_SEARCH_TIMEOUT=20
ENABLE_WEB_SEARCH_FALLBACK=true
WEB_SEARCH_BLOCKLIST_DOMAINS=namu.wiki,blog.naver.com,m.blog.naver.com,tistory.com,wikipedia.org,ko.wikipedia.org

# External evidence providers. Keep real keys only in this local .env file.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TOPIC=general
KIPRIS_API_KEY=YOUR_KIPRIS_API_KEY
KOSIS_API_KEY=YOUR_KOSIS_API_KEY

RETURN_PERFORMANCE=true
RAG_QUERY_LOG_PATH=./logs/rag_query_log.jsonl
WIKI_AUDITOR_ROOT=./logs/wiki_auditor

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
