    function fnInitPage() {
    	var pageTp = '01';
    	pageTp = pageTp==''?'01':pageTp;
    	var pageTp = parseInt(pageTp)-1;
    	$('.tabNav > li').removeClass('active');
    	$('.tabNav > li').eq(pageTp).addClass('active');
    }

    /**
     * 이벤트 등록
     * @returns
     */
    function fnBindEvent() {
    	$('.tabNav > li > a').click(function(){
    		var idx = $(this).parent().index();
    		idx++;
    		idx = idx<10?'0'+idx:idx;

    		var frm = $('<form></form>');
            frm.attr('action','/smart/jsp/ka/menu/guide/main/GuideMain0207.do');
            frm.attr('method','post');
            frm.append('<input type="hidden" name="pageTp" value="'+idx+'">')
    		$('body').append(frm);
            frm.submit();
    	});
    }
</script>
