	function ENGCHAR_CHECK( check_num ) {
		var temp_char_code;
		for(var inxA=0; inxA<check_num.length; inxA++) {
			temp_char_code = check_num.charCodeAt(inxA);
			if(inxA==0 && temp_char_code == 32) {
			    return false;
			}
			if(temp_char_code < 48 || temp_char_code > 122 ||
			   (temp_char_code > 57 && temp_char_code < 65 ) ||
			   (temp_char_code > 90 && temp_char_code < 97 )) {
			    return false;
			}
		}
		
		return true;
	}
	
	function Digit_Check() {
		var objInpForm = document.getElementById("input_form");
		var aplt_cd = objInpForm['aplt_ApTpCd'].value + objInpForm['aplt_RgYear'].value + objInpForm['aplt_SrlNo'].value + objInpForm['aplt_ChkDgt'].value;
		
		//출원인(대리인)코드를 Check
		if(!CoCheckApagtCd( aplt_cd )) {
			alert( "특허고객(대리인)번호의 체크디지트가 잘못되었습니다. 다시 입력해주세요." );
			objInpForm['aplt_ApTpCd'].focus();
		} else {
		    doSubmit();
		}
	}

	function doSubmit() {
		var objInpForm = document.getElementById("input_form");
