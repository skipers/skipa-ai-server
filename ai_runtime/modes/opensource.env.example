# Open-source provider profile.
# Copy to ai_runtime/modes/opensource.env for local use.

AI_PROVIDER=opensource

# In-cluster Kubernetes service URLs
OPEN_SOURCE_LLM_BASE_URL=http://skipa-llm:8000/v1
OPEN_SOURCE_EMBEDDING_BASE_URL=http://skipa-embedding:8001/v1

# Local port-forward URLs
# kubectl port-forward svc/skipa-llm 18000:8000
# kubectl port-forward svc/skipa-embedding 18001:8001
# OPEN_SOURCE_LLM_BASE_URL=http://127.0.0.1:18000/v1
# OPEN_SOURCE_EMBEDDING_BASE_URL=http://127.0.0.1:18001/v1

OPEN_SOURCE_LLM_API_KEY=EMPTY
OPEN_SOURCE_EMBEDDING_API_KEY=EMPTY

OPEN_SOURCE_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OPEN_SOURCE_REPORT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OPEN_SOURCE_PRE_APPLICATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OPEN_SOURCE_EVAL_LOGIC_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OPEN_SOURCE_PORTFOLIO_INSIGHTS_MODEL=Qwen/Qwen2.5-1.5B-Instruct
OPEN_SOURCE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

EMBEDDING_REQUEST_DIMENSIONS=false
LLM_REQUEST_JSON_RESPONSE_FORMAT=true

QDRANT_COLLECTION_PREFIX=opensource
QDRANT_VECTOR_SIZE=2560
BUSINESS_RAG_INDEX_PREFIX=opensource_

INTENT_PROVIDER=opensource
ANSWER_PROVIDER=opensource
EMBEDDING_PROVIDER=opensource
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
INTENT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
ANSWER_MODEL=Qwen/Qwen2.5-1.5B-Instruct
